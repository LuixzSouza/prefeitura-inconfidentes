# Banco de dados PostgreSQL (ex: Neon, Supabase ou local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/prefeitura"
# Conexão direta (sem pooler). Localmente pode ser igual à DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5432/prefeitura"

# NextAuth — gere um segredo com: npx auth secret  (ou openssl rand -base64 32)
NEXTAUTH_SECRET="troque-este-valor"
NEXTAUTH_URL="http://localhost:3000"

# Opcional: credenciais do admin criado pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@inconfidentes.mg.gov.br"
SEED_ADMIN_PASSWORD="admin"
